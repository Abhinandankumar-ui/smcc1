# ==============================================
# Client Environment Variables (Template)
# Duplicate this file to .env and configure as needed
# ==============================================

# Backend API Base URL
# Local dev: leave empty to use local Vite reverse proxy
# Production: e.g. https://api.yourdomain.com or https://smcclub-backend.onrender.com
VITE_API_BASE_URL=

# Application Details
VITE_APP_NAME="SMC Robotics & IoT Club"
VITE_APP_URL="http://localhost:5173"
