# ==============================================
# Client Environment Variables (Vite)
# NOTE: All client-side env variables MUST start with VITE_
# ==============================================

# Backend API Base URL
# - In local development: Leave blank to use Vite's built-in proxy (defined in vite.config.js)
# - In production (Vercel / Netlify): Set to your deployed backend URL (e.g., https://smcclub-backend.onrender.com)
VITE_API_BASE_URL=https://smcclub-1.onrender.com

# Application Details
VITE_APP_NAME="SMC Robotics & IoT Club"
VITE_APP_URL="http://localhost:5173"
